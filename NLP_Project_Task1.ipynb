    {
      "cell_type": "markdown",
      "source": [
        "# Pre procesisng\n",
        " 1. Lowercase everything\n",
        " 2. Tokenize into words\n",
        " 3. Keep only alphabetic words (removes numbers, punctuation)\n",
        " 4. Remove common stop words (the, is, a, ...)\n",
        " 5. Lemmatize (running -> run, better -> good)"
      ],
      "metadata": {
        "id": "zrzArrres27G"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def preprocess(texts):\n",
        "    lemmatizer = WordNetLemmatizer()\n",
        "    stop_words = set(stopwords.words(\"english\"))\n",
        "    result = []\n",
        "    for doc in texts:\n",
        "        tokens = word_tokenize(doc.lower())\n",
        "        tokens = [t for t in tokens if t.isalpha() and t not in stop_words]\n",
        "        tokens = [lemmatizer.lemmatize(t) for t in tokens]\n",
        "        result.append(tokens)\n",
        "    return result\n",
        "\n",
        "print(\"Preprocessing... (~ 1 min)\")\n",
        "train_tokens = preprocess(train_data.data)\n",
        "test_tokens  = preprocess(test_data.data)\n",
        "print(\"Done.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "NO8bd842rocW",
        "outputId": "081e407e-96c7-4c7d-f344-78ba868267cc"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Preprocessing... (~ 1 min)\n",
            "Done.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "\n",
        "# STEP 3: Train Word2Vec - 1 epoch vs 10 epochs (Task 1b)\n",
        "\n",
        "### Word2Vec learns word meaning from context.\n",
        "### More epochs = more training = vectors that better capture meaning."
      ],
      "metadata": {
        "id": "976lxwx33NgI"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "all_tokens = train_tokens + test_tokens\n",
        "\n",
        "w2v_1  = Word2Vec(sentences=all_tokens, vector_size=100, window=5, min_count=2, epochs=1,  seed=42)\n",
        "w2v_10 = Word2Vec(sentences=all_tokens, vector_size=100, window=5, min_count=2, epochs=10, seed=42)\n",
        "\n",
        "print(f\"Vocabulary: {len(w2v_1.wv)} words\")"
      ],
